# 複製此檔為 .streamlit/secrets.toml（本機用）
# Streamlit Cloud 上請到 App Settings → Secrets 填入同樣內容

# ── Alpaca（選填：有填才顯示即時資料）──────────────────────────
ALPACA_API_KEY    = "your_alpaca_api_key_here"
ALPACA_API_SECRET = "your_alpaca_api_secret_here"
ALPACA_BASE_URL   = "https://paper-api.alpaca.markets/v2"

# ── GitHub（選填：提升 API 速率限制）───────────────────────────
GITHUB_REPO  = "d225d225/alpaca-bot"
GITHUB_TOKEN = ""          # Personal Access Token（read-only 即可）

# ── Email（GitHub Actions 用）──────────────────────────────────
EMAIL_TO         = "yourname@example.com"
SENDGRID_API_KEY = ""
SMTP_USER        = ""
SMTP_PASS        = ""
